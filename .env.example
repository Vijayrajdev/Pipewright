# Copy to .env.local. Everything except the chat works with no AI at all.

# Option 1 — free & local: install Ollama (https://ollama.com), run `ollama pull llama3.2`.
# Pipewright finds it automatically on http://localhost:11434.
# OLLAMA_MODEL=llama3.2
# OLLAMA_URL=http://localhost:11434

# Option 2 — Claude (paid API): when set, Claude is used instead of Ollama.
ANTHROPIC_API_KEY=
# PIPEWRIGHT_MODEL=claude-sonnet-5-5

# Force one provider: anthropic | ollama
# AI_PROVIDER=ollama
