rules_version = '2';

// Pipewright cloud accounts. Each signed-in user can reach only their own
// documents. The plan field starts as "free" and can't be changed from the
// browser, so a future billing server (Admin SDK) is the only thing that can
// upgrade an account.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create: if isOwner(uid) && request.resource.data.plan == "free";
      allow update: if isOwner(uid) && request.resource.data.plan == resource.data.plan;

      match /data/{name} {
        allow read, delete: if isOwner(uid);
        allow write: if isOwner(uid)
          && name in ["schema", "recent", "workspace"]
          && request.resource.data.value is string
          && request.resource.data.value.size() < 1000000
          && request.resource.data.updatedAt is number;
      }
    }

    // everything else is closed
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
