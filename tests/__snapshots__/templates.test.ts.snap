exports[`templates > quality / bigquery matches snapshot 1`] = `
"-- Data quality checks for orders. Each row is one check; compare observed to expected.
SELECT 'row_count' AS check_name, COUNT(*) AS observed, '> 0' AS expected FROM \`sales.orders\`
UNION ALL
SELECT 'nulls_in_order_id' AS check_name, COUNT(*) - COUNT(order_id) AS observed, '= 0' AS expected FROM \`sales.orders\`
UNION ALL
SELECT 'nulls_in_created_at' AS check_name, COUNT(*) - COUNT(created_at) AS observed, '= 0' AS expected FROM \`sales.orders\`
UNION ALL
SELECT 'duplicate_order_id' AS check_name, COUNT(*) AS observed, '= 0' AS expected FROM (SELECT order_id FROM \`sales.orders\` GROUP BY order_id HAVING COUNT(*) > 1) AS dupes
UNION ALL
SELECT 'hours_since_latest_updated_at' AS check_name, TIMESTAMP_DIFF(CURRENT_TIMESTAMP(), MAX(updated_at), HOUR) AS observed, '<= 24' AS expected FROM \`sales.orders\`;"
`;

exports[`templates > quality / databricks matches snapshot 1`] = `
"-- Data quality checks for orders. Each row is one check; compare observed to expected.
SELECT 'row_count' AS check_name, COUNT(*) AS observed, '> 0' AS expected FROM sales.orders
UNION ALL
SELECT 'nulls_in_order_id' AS check_name, COUNT(*) - COUNT(order_id) AS observed, '= 0' AS expected FROM sales.orders
UNION ALL
SELECT 'nulls_in_created_at' AS check_name, COUNT(*) - COUNT(created_at) AS observed, '= 0' AS expected FROM sales.orders
UNION ALL
SELECT 'duplicate_order_id' AS check_name, COUNT(*) AS observed, '= 0' AS expected FROM (SELECT order_id FROM sales.orders GROUP BY order_id HAVING COUNT(*) > 1) AS dupes
UNION ALL
SELECT 'hours_since_latest_updated_at' AS check_name, FLOOR((UNIX_TIMESTAMP(CURRENT_TIMESTAMP()) - UNIX_TIMESTAMP(MAX(updated_at))) / 3600) AS observed, '<= 24' AS expected FROM sales.orders;"
`;

exports[`templates > quality / postgres matches snapshot 1`] = `
"-- Data quality checks for orders. Each row is one check; compare observed to expected.
SELECT 'row_count' AS check_name, COUNT(*) AS observed, '> 0' AS expected FROM sales.orders
UNION ALL
SELECT 'nulls_in_order_id' AS check_name, COUNT(*) - COUNT(order_id) AS observed, '= 0' AS expected FROM sales.orders
UNION ALL
SELECT 'nulls_in_created_at' AS check_name, COUNT(*) - COUNT(created_at) AS observed, '= 0' AS expected FROM sales.orders
UNION ALL
SELECT 'duplicate_order_id' AS check_name, COUNT(*) AS observed, '= 0' AS expected FROM (SELECT order_id FROM sales.orders GROUP BY order_id HAVING COUNT(*) > 1) AS dupes
UNION ALL
SELECT 'hours_since_latest_updated_at' AS check_name, FLOOR(EXTRACT(EPOCH FROM (NOW() - MAX(updated_at))) / 3600)::BIGINT AS observed, '<= 24' AS expected FROM sales.orders;"
`;

exports[`templates > quality / snowflake matches snapshot 1`] = `
"-- Data quality checks for orders. Each row is one check; compare observed to expected.
SELECT 'row_count' AS check_name, COUNT(*) AS observed, '> 0' AS expected FROM sales.orders
UNION ALL
SELECT 'nulls_in_order_id' AS check_name, COUNT(*) - COUNT(order_id) AS observed, '= 0' AS expected FROM sales.orders
UNION ALL
SELECT 'nulls_in_created_at' AS check_name, COUNT(*) - COUNT(created_at) AS observed, '= 0' AS expected FROM sales.orders
UNION ALL
SELECT 'duplicate_order_id' AS check_name, COUNT(*) AS observed, '= 0' AS expected FROM (SELECT order_id FROM sales.orders GROUP BY order_id HAVING COUNT(*) > 1) AS dupes
UNION ALL
SELECT 'hours_since_latest_updated_at' AS check_name, DATEDIFF('hour', MAX(updated_at), CURRENT_TIMESTAMP()) AS observed, '<= 24' AS expected FROM sales.orders;"
`;

exports[`templates > scd2 / bigquery matches snapshot 1`] = `
"-- SCD Type 2 load from orders_staging into orders_history.
-- orders_history has the same columns plus valid_from, valid_to, is_current.
-- Tracked columns: customer_email, amount, tags, created_at. Run both steps in one transaction.
-- Assumes orders_staging has one row per key; run the Deduplicate template on it first if not.

-- Step 1: close the current version of rows whose tracked columns changed.
MERGE INTO \`sales.orders_history\` AS t
USING \`sales.orders_staging\` AS s
ON t.order_id = s.order_id AND t.is_current
WHEN MATCHED AND (
    t.customer_email IS DISTINCT FROM s.customer_email
    OR t.amount IS DISTINCT FROM s.amount
    OR TO_JSON_STRING(t.tags) IS DISTINCT FROM TO_JSON_STRING(s.tags)
    OR t.created_at IS DISTINCT FROM s.created_at
  ) THEN UPDATE SET
  valid_to = s.updated_at,
  is_current = FALSE;

-- Step 2: insert a new current version for new keys and for rows closed in step 1.
INSERT INTO \`sales.orders_history\` (order_id, customer_email, amount, tags, created_at, updated_at, valid_from, valid_to, is_current)
SELECT s.order_id, s.customer_email, s.amount, s.tags, s.created_at, s.updated_at, s.updated_at, NULL, TRUE
FROM \`sales.orders_staging\` AS s
LEFT JOIN \`sales.orders_history\` AS t
  ON t.order_id = s.order_id AND t.is_current
WHERE t.order_id IS NULL;"
`;

exports[`templates > scd2 / databricks matches snapshot 1`] = `
"-- SCD Type 2 load from orders_staging into orders_history.
-- orders_history has the same columns plus valid_from, valid_to, is_current.
-- Tracked columns: customer_email, amount, tags, created_at. Run both steps in one transaction.
-- Assumes orders_staging has one row per key; run the Deduplicate template on it first if not.

-- Step 1: close the current version of rows whose tracked columns changed.
MERGE INTO sales.orders_history AS t
USING sales.orders_staging AS s
ON t.order_id = s.order_id AND t.is_current
WHEN MATCHED AND (
    NOT (t.customer_email <=> s.customer_email)
    OR NOT (t.amount <=> s.amount)
    OR NOT (t.tags <=> s.tags)
    OR NOT (t.created_at <=> s.created_at)
  ) THEN UPDATE SET
  valid_to = s.updated_at,
  is_current = FALSE;

-- Step 2: insert a new current version for new keys and for rows closed in step 1.
INSERT INTO sales.orders_history (order_id, customer_email, amount, tags, created_at, updated_at, valid_from, valid_to, is_current)
SELECT s.order_id, s.customer_email, s.amount, s.tags, s.created_at, s.updated_at, s.updated_at, NULL, TRUE
FROM sales.orders_staging AS s
LEFT JOIN sales.orders_history AS t
  ON t.order_id = s.order_id AND t.is_current
WHERE t.order_id IS NULL;"
`;

exports[`templates > scd2 / postgres matches snapshot 1`] = `
"-- SCD Type 2 load from orders_staging into orders_history.
-- orders_history has the same columns plus valid_from, valid_to, is_current.
-- Tracked columns: customer_email, amount, tags, created_at. Run both steps in one transaction.
-- Assumes orders_staging has one row per key; run the Deduplicate template on it first if not.

-- Step 1: close the current version of rows whose tracked columns changed.
UPDATE sales.orders_history AS t
SET valid_to = s.updated_at, is_current = FALSE
FROM sales.orders_staging AS s
WHERE t.order_id = s.order_id
  AND t.is_current
  AND (
    t.customer_email IS DISTINCT FROM s.customer_email
    OR t.amount IS DISTINCT FROM s.amount
    OR t.tags IS DISTINCT FROM s.tags
    OR t.created_at IS DISTINCT FROM s.created_at
  );

-- Step 2: insert a new current version for new keys and for rows closed in step 1.
INSERT INTO sales.orders_history (order_id, customer_email, amount, tags, created_at, updated_at, valid_from, valid_to, is_current)
SELECT s.order_id, s.customer_email, s.amount, s.tags, s.created_at, s.updated_at, s.updated_at, NULL, TRUE
FROM sales.orders_staging AS s
LEFT JOIN sales.orders_history AS t
  ON t.order_id = s.order_id AND t.is_current
WHERE t.order_id IS NULL;"
`;

