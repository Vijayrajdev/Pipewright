exports[`templates > upsert / bigquery matches snapshot 1`] = `
"-- Upsert orders_staging into orders: update changed rows, insert new ones.
MERGE INTO \`sales.orders\` AS t
USING (
  SELECT * FROM \`sales.orders_staging\` WHERE TRUE
  QUALIFY ROW_NUMBER() OVER (PARTITION BY order_id ORDER BY updated_at DESC) = 1
) AS s
ON t.order_id = s.order_id
WHEN MATCHED AND (t.updated_at IS NULL OR s.updated_at > t.updated_at) THEN UPDATE SET
  customer_email = s.customer_email,
  amount = s.amount,
  tags = s.tags,
  created_at = s.created_at,
  updated_at = s.updated_at
WHEN NOT MATCHED THEN INSERT (order_id, customer_email, amount, tags, created_at, updated_at)
  VALUES (s.order_id, s.customer_email, s.amount, s.tags, s.created_at, s.updated_at);"
`;

exports[`templates > upsert / databricks matches snapshot 1`] = `
"-- Upsert orders_staging into orders: update changed rows, insert new ones.
MERGE INTO sales.orders AS t
USING (
  SELECT * FROM sales.orders_staging
  QUALIFY ROW_NUMBER() OVER (PARTITION BY order_id ORDER BY updated_at DESC) = 1
) AS s
ON t.order_id = s.order_id
WHEN MATCHED AND (t.updated_at IS NULL OR s.updated_at > t.updated_at) THEN UPDATE SET
  customer_email = s.customer_email,
  amount = s.amount,
  tags = s.tags,
  created_at = s.created_at,
  updated_at = s.updated_at
WHEN NOT MATCHED THEN INSERT (order_id, customer_email, amount, tags, created_at, updated_at)
  VALUES (s.order_id, s.customer_email, s.amount, s.tags, s.created_at, s.updated_at);"
`;

exports[`templates > upsert / postgres matches snapshot 1`] = `
"-- Upsert orders_staging into orders. Requires a UNIQUE constraint on (order_id).
INSERT INTO sales.orders AS t (order_id, customer_email, amount, tags, created_at, updated_at)
SELECT DISTINCT ON (order_id) order_id, customer_email, amount, tags, created_at, updated_at
FROM sales.orders_staging
ORDER BY order_id, updated_at DESC
ON CONFLICT (order_id) DO UPDATE SET
  customer_email = EXCLUDED.customer_email,
  amount = EXCLUDED.amount,
  tags = EXCLUDED.tags,
  created_at = EXCLUDED.created_at,
  updated_at = EXCLUDED.updated_at
WHERE t.updated_at IS NULL OR t.updated_at < EXCLUDED.updated_at;"
`;

