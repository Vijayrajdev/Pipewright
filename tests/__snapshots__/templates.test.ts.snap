exports[`templates > dedupe / bigquery matches snapshot 1`] = `
"-- Keep one row per order_id, the latest by updated_at.
SELECT *
FROM \`sales.orders\`
WHERE TRUE
QUALIFY ROW_NUMBER() OVER (
  PARTITION BY order_id
  ORDER BY updated_at DESC
) = 1;"
`;

exports[`templates > dedupe / databricks matches snapshot 1`] = `
"-- Keep one row per order_id, the latest by updated_at.
