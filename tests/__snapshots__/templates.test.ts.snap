`;

exports[`templates > dedupe / postgres matches snapshot 1`] = `
"-- Keep one row per order_id, the latest by updated_at.
SELECT DISTINCT ON (order_id) *
FROM sales.orders
ORDER BY order_id, updated_at DESC;"
`;

