exports[`emitters > bq-ddl matches snapshot 1`] = `
"CREATE TABLE IF NOT EXISTS \`sales.orders\` (
  order_id INT64 NOT NULL OPTIONS(description="Primary key"),
  customer_id STRING NOT NULL,
  amount NUMERIC OPTIONS(description="Order total in USD, incl. 'tax'"),
  created_at TIMESTAMP NOT NULL,
  tags ARRAY<STRING>,
  shipping STRUCT<city STRING, shipped_on DATE>
)
PARTITION BY DATE(created_at)
CLUSTER BY customer_id
OPTIONS(description="One row per order");"
`;

