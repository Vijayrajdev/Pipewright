exports[`emitters > pg-ddl matches snapshot 1`] = `
"CREATE TABLE IF NOT EXISTS sales.orders (
  order_id BIGINT NOT NULL,
  customer_id TEXT NOT NULL,
  amount NUMERIC(38,9),
  created_at TIMESTAMPTZ NOT NULL,
  tags TEXT[],
  shipping JSONB
);
COMMENT ON TABLE sales.orders IS 'One row per order';
COMMENT ON COLUMN sales.orders.order_id IS 'Primary key';
COMMENT ON COLUMN sales.orders.amount IS 'Order total in USD, incl. ''tax''';
-- To partition, add: PARTITION BY RANGE (created_at) to the CREATE TABLE
CREATE INDEX IF NOT EXISTS idx_orders_customer_id ON sales.orders (customer_id);"
`;

exports[`emitters > pyspark matches snapshot 1`] = `
"from pyspark.sql.types import (
    StructType, StructField, ArrayType, StringType, LongType, DoubleType,
    DecimalType, BooleanType, DateType, TimestampType, BinaryType,
)

orders_schema = StructType([
    StructField("order_id", LongType(), False, metadata={"comment": "Primary key"}),
    StructField("customer_id", StringType(), False),
    StructField("amount", DecimalType(38, 9), True, metadata={"comment": "Order total in USD, incl. 'tax'"}),
    StructField("created_at", TimestampType(), False),
    StructField("tags", ArrayType(StringType(), True), True),
    StructField("shipping", StructType([
        StructField("city", StringType(), True),
        StructField("shipped_on", DateType(), True),
    ]), True),
])"
`;

exports[`emitters > sf-ddl matches snapshot 1`] = `
"CREATE TABLE IF NOT EXISTS SALES.ORDERS (
  ORDER_ID NUMBER(38,0) NOT NULL COMMENT 'Primary key',
  CUSTOMER_ID VARCHAR NOT NULL,
  AMOUNT NUMBER(38,9) COMMENT 'Order total in USD, incl. ''tax''',
  CREATED_AT TIMESTAMP_TZ NOT NULL,
  TAGS ARRAY,
  SHIPPING OBJECT
)
CLUSTER BY (CUSTOMER_ID)
COMMENT = 'One row per order';"
`;
